					</Properties>
					<Action><![CDATA[for(int i=0; i<заказы.size(); i++)
		{	if (time() == (max(0, заказы.get(i).tDeadline - time())))
			traceln("событие для агента = " + i);
			заказы.get(i).function(); 
	//заказы.get(i).контрольДедлайна.restart();
	}]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Курьер]]></ReturnType>
					<Id>1774787326698</Id>
					<Name><![CDATA[найтиБлижайшегоКурьера]]></Name>
					<X>-820</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[Заказ]]></Name>
						<Type><![CDATA[Заказ]]></Type>
					</Parameter>
					<Body><![CDATA[Курьер best = null;
double bestScore = Double.POSITIVE_INFINITY;

if (Заказ == null) {
    return null;
}

for (int i = 0; i < myAgent1.size(); i++) {
    Курьер c = myAgent1.get(i);

    if (!курьерДопустим(c, Заказ)) {
        continue;
    }

    double score = рассчитатьScoreНазначения(c, Заказ);
   // traceln(
	  //  "CANDIDATE " + c +
	  //  " | etaPickup=" + рассчитатьEtaPickup(c, Заказ) +
	  //  " | etaDrop=" + рассчитатьEtaDrop(c, Заказ) +
	   // " | latePenalty=" + рассчитатьLatePenalty(c, Заказ) +
	    //" | score=" + score
	//);

    if (score < bestScore) {
        bestScore = score;
        best = c;
    }
}
//traceln("BEST for " + Заказ + " = " + best + " | bestScore=" + bestScore);

return best;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775255161331</Id>
					<Name><![CDATA[расстояниеКм]]></Name>
					<X>-820</X><Y>70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[lat1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lon1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lat2]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lon2]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double R = 6371.0;

double dLat = Math.toRadians(lat2 - lat1);
double dLon = Math.toRadians(lon2 - lon1);

double a = Math.sin(dLat / 2) * Math.sin(dLat / 2)
         + Math.cos(Math.toRadians(lat1)) * Math.cos(Math.toRadians(lat2))
         * Math.sin(dLon / 2) * Math.sin(dLon / 2);

double c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

return R * c;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775312725489</Id>
					<Name><![CDATA[расстояниеМ]]></Name>
					<X>-820</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[lat1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lon1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lat2]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lon2]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[return расстояниеКм(lat1, lon1, lat2, lon2) * 1000.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775312806137</Id>
					<Name><![CDATA[рассчитатьEtaPickup]]></Name>
					<X>-820</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[c]]></Name>
						<Type><![CDATA[Курьер]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[z]]></Name>
						<Type><![CDATA[Заказ]]></Type>
