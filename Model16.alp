							<Value Class="CodeValue">
								<Code><![CDATA[Point p = областьДоставки.randomPointInside();

agent.точкаКлиента = p;
agent.широтаКлиента = p.getLatitude();
agent.долготаКлиента = p.getLongitude();


com.anylogic.engine.Point даркСтор = new com.anylogic.engine.Point(); 
даркСтор.setLocation(55.751244,37.618423);
//traceln("Сформирован заказ, даркСтор = " + даркСтор.getLatitude());
agent.широтаЗабора = даркСтор.getLatitude();
agent.долготаЗабора = даркСтор.getLongitude();

agent.tCreate = time();
agent.prepTime = uniform(5*minute(), 15*minute());
agent.tReady = agent.tCreate + agent.prepTime;
agent.tDeadline = agent.tCreate + 60*minute();
agent.function();
//agent.контрольДедлайна.reset();

agent.isReady = false;

/*traceln(
	"time = " +time() +
	", tCreate = " + agent.tCreate +
	", agent.prepTime = " + agent.prepTime +
	", agent.tReady = " + agent.tReady +
	", agent.tDeadline  = " + agent.tDeadline

);
traceln();*/


