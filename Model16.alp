				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775338901409</Id>
					<Name><![CDATA[рассчитатьP95]]></Name>
					<X>-1360</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (deliveryTimes.isEmpty()) {
    return 0;
}

ArrayList<Double> sorted = new ArrayList<>(deliveryTimes);
Collections.sort(sorted);

int n = sorted.size();
int index = (int) Math.ceil(0.95 * n) - 1;

index = max(0, min(index, n - 1));

return sorted.get(index);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775338901411</Id>
					<Name><![CDATA[рассчитатьТекущуюЗагрузкуКурьеров]]></Name>
					<X>-1360</X><Y>140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (myAgent1.isEmpty()) {
    return 0;
}

int busyCount = 0;

for (int i = 0; i < myAgent1.size(); i++) {
    if (myAgent1.get(i).isBusy) {
        busyCount++;
    }
}

return (double) busyCount / myAgent1.size();]]></Body>
				</Function>
