				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775318844683</Id>
					<Name><![CDATA[рассчитатьLatePenalty]]></Name>
					<X>-1130</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[c]]></Name>
						<Type><![CDATA[Курьер]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[z]]></Name>
						<Type><![CDATA[Заказ]]></Type>
					</Parameter>
					<Body><![CDATA[double etaPickup = рассчитатьEtaPickup(c, z);
double etaDrop = рассчитатьEtaDrop(c, z);

double finishForecast =
    time()
    + etaPickup
    + pickupServiceTime
    + etaDrop
    + handoverTime;

return max(0, finishForecast - z.tDeadline);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775318886138</Id>
					<Name><![CDATA[рассчитатьScoreНазначения]]></Name>
					<X>-1130</X><Y>70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[c]]></Name>
						<Type><![CDATA[Курьер]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[z]]></Name>
						<Type><![CDATA[Заказ]]></Type>
					</Parameter>
					<Body><![CDATA[double etaPickup = рассчитатьEtaPickup(c, z);
double etaDrop = рассчитатьEtaDrop(c, z);
double latePenalty = рассчитатьLatePenalty(c, z);

return alphaPickup * etaPickup
     + betaDrop * etaDrop
     + gammaLate * latePenalty;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
