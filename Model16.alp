							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[agent.tFinish = time();
agent.actualDeliveryTime = agent.tFinish - agent.tCreate;
agent.isCompleted = true;

agent.onTime = !agent.deadlineMissed;
//traceln("agent.deadlineMissed = true; AGENT = " +agent.getId());

completedOrders++;
deliveryTimes.add(agent.actualDeliveryTime);

if (agent.onTime) {
    onTimeOrders++;
}

slaPercent = completedOrders == 0 ? 0 : 100.0 * onTimeOrders / completedOrders;

//traceln(
  //  "FINISH: order=" + agent +
  //  " | tCreate=" + agent.tCreate +
  //  " | tDeadline=" + agent.tDeadline +
   // " | tFinish=" + agent.tFinish +
   // " | actualDeliveryTime=" + agent.actualDeliveryTime +
   // " | deadlineMissed=" + agent.deadlineMissed +
   // " | onTime=" + agent.onTime
//);]]></Code>
