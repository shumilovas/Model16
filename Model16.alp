			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Курьер]]></ReturnType>
					<Id>1774787326698</Id>
					<Name><![CDATA[найтиБлижайшегоКурьера]]></Name>
					<X>80</X><Y>140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Body><![CDATA[Курьер myA = null;

double minDistance = 100;
double foundedDistance = 0;

traceln("РАЗМЕР ПОПУЛЯЦИИ "+myAgent1.size());
for (int i=0;i<myAgent1.size();i++){
 	traceln("итератор "+i); 	
 	traceln(myAgent1.get(i).parameter);
 	Курьер myAgentCheck = myAgent1.get(i);
	double dist = getDistance(agent.getX(), 
							  agent.getY(), 
							  myAgentCheck.getX(), 
							  myAgentCheck.getY());
	
	if (dist <= minDistance && foundedDistance < dist && !myAgentCheck.isBusy ) {
		myA = myAgentCheck;
 		foundedDistance = dist;
 	}
}

//traceln("Выбран агент MyA под id " + myA.getId() +" distance " +foundedDistance);
traceln(" __________________");

return myA;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775062367437</Id>
					<Name><![CDATA[определитьТочкиДляЗаказа]]></Name>
					<X>70</X><Y>80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (int k=0; k<количествоМестДляЗаказов; k++) {
	случайнаяТочкаЗаказаВГеоКоорд=nvrn.randomPointInside();
    коллекцияТочекДляЗаказа.add(случайнаяТочкаЗаказаВГеоКоорд);
}
  ]]></Body>
				</Function>
