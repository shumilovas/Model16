					<Body><![CDATA[double distM = рассчитатьDistancePickupМ(c, z);
return distM / скоростьМ_Мин;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775312868777</Id>
					<Name><![CDATA[рассчитатьEtaDrop]]></Name>
					<X>-820</X><Y>160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[c]]></Name>
						<Type><![CDATA[Курьер]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[z]]></Name>
						<Type><![CDATA[Заказ]]></Type>
					</Parameter>
					<Body><![CDATA[double distM = рассчитатьDistanceDropМ(z);
return distM / скоростьМ_Мин;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1775312912016</Id>
					<Name><![CDATA[курьерДопустим]]></Name>
					<X>-820</X><Y>190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[c]]></Name>
						<Type><![CDATA[Курьер]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[z]]></Name>
						<Type><![CDATA[Заказ]]></Type>
					</Parameter>
					<Body><![CDATA[//traceln(
   // "Курьер coords: lat=" + c.getLatitude() +
   // ", lon=" + c.getLongitude() +
   // " | pickup: lat=" + z.широтаЗабора +
   // ", lon=" + z.долготаЗабора
//);

if (c == null || z == null) {
    //traceln("REJECT: c == null или z == null");
    return false;
}

if (c.isBusy) {
   // traceln("REJECT " + c + ": isBusy");
    return false;
}

if (!c.onShift) {
    //traceln("REJECT " + c + ": onShift = false");
    return false;
}

if (time() < c.bannedUntil) {
    //traceln("REJECT " + c + ": bannedUntil = " + c.bannedUntil + ", time = " + time());
    return false;
}

double etaPickup = рассчитатьEtaPickup(c, z);
if (etaPickup > T_search) {
    //traceln("REJECT " + c + ": etaPickup = " + etaPickup + " > T_search = " + T_search);
    return false;
}

double etaDrop = рассчитатьEtaDrop(c, z);

double finishForecast =
    time()
    + etaPickup
    + pickupServiceTime
    + etaDrop
    + handoverTime;

if (finishForecast > z.tDeadline) {
   // traceln("REJECT " + c + ": finishForecast = " + finishForecast + " > deadline = " + z.tDeadline);
    return false;
}

//traceln("ACCEPT " + c + ": etaPickup = " + etaPickup + ", etaDrop = " + etaDrop);
return true;

//traceln(даркСтор.getLatitude());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775318253495</Id>
					<Name><![CDATA[рассчитатьDistancePickupМ]]></Name>
					<X>-820</X><Y>220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
