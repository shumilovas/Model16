							<Name><![CDATA[forceStatisticsCollection]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if (agent == null) {
    traceln("agent == null");
}]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExitTimeout]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExitPreempted]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onSeizeUnit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Курьер c = (Курьер) unit;

c.isBusy = true;
agent.назначенныйКурьер = c;

agent.расстояниеPickupМ = рассчитатьDistancePickupМ(c, agent);
agent.расстояниеDropМ = рассчитатьDistanceDropМ(agent);

agent.etaPickup = рассчитатьEtaPickup(c, agent);
agent.etaDrop = рассчитатьEtaDrop(c, agent);

agent.прогнозНачалаДоставки = time() + agent.etaPickup + времяЗабора;
agent.прогнозЗавершения = time() + agent.etaPickup + времяЗабора + agent.etaDrop + времяПередачи;

agent.latePenalty = рассчитатьLatePenalty(c, agent);
agent.scoreНазначения = рассчитатьScoreНазначения(c, agent);

traceln(
    "ASSIGN: order=" + agent +
    " | courier=" + c +
    " | pickupDistM=" + agent.расстояниеPickupМ +
    " | dropDistM=" + agent.расстояниеDropМ +
    " | etaPickup=" + agent.etaPickup +
    " | etaDrop=" + agent.etaDrop +
    " | finishForecast=" + agent.прогнозЗавершения
);]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onPrepareUnit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[agent.курьерПринялЗаказ = курьерПринимаетЗаказ(agent.назначенныйКурьер, agent);
traceln(
    "DECISION: order=" + agent +
    " | courier=" + agent.назначенныйКурьер +
    " | accepted=" + agent.курьерПринялЗаказ
);]]></Code>
							</Value>
						</Parameter>
