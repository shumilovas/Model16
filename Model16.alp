								<Code><![CDATA[Курьер c = (Курьер) unit;

c.isBusy = false;
c.bannedUntil = time() + tauBan;

agent.последнийОтказавшийсяКурьер = c;
agent.числоОтказов++;

agent.назначенныйКурьер = null;

traceln(
    "REFUSAL: order=" + agent +
    " | courier=" + unit +
    " | bannedUntil=" + ((Курьер)unit).bannedUntil +
    " | refusals=" + agent.числоОтказов
);]]></Code>
