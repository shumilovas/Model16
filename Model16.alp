			<Events>
				<Event>
					<Id>1775338901887</Id>
					<Name><![CDATA[мониторингЗагрузки]]></Name>
					<X>-1420</X><Y>240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1775376000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1 * minute()]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[int busyCount = 0;

for (int i = 0; i < myAgent1.size(); i++) {
    if (myAgent1.get(i).isBusy) {
        busyCount++;
    }
}

double currentUtilization = myAgent1.isEmpty() ? 0 : (double) busyCount / myAgent1.size();

utilSum += currentUtilization;
utilSamples++;

avgUtilization = utilSamples == 0 ? 0 : utilSum / utilSamples;]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Курьер]]></ReturnType>
					<Id>1775338901385</Id>
					<Name><![CDATA[найтиБлижайшегоКурьера]]></Name>
					<X>-1100</X><Y>60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[Заказ]]></Name>
						<Type><![CDATA[Заказ]]></Type>
					</Parameter>
					<Body><![CDATA[Курьер best = null;
double bestScore = Double.POSITIVE_INFINITY;

if (Заказ == null) {
    return null;
}

for (int i = 0; i < myAgent1.size(); i++) {
    Курьер c = myAgent1.get(i);

    if (!курьерДопустим(c, Заказ)) {
        continue;
    }

    double score = рассчитатьScoreНазначения(c, Заказ);
    traceln(
	    "CANDIDATE " + c +
	    " | etaPickup=" + рассчитатьEtaPickup(c, Заказ) +
	    " | etaDrop=" + рассчитатьEtaDrop(c, Заказ) +
	    " | latePenalty=" + рассчитатьLatePenalty(c, Заказ) +
	    " | score=" + score
	);

    if (score < bestScore) {
        bestScore = score;
        best = c;
    }
}
traceln("BEST for " + Заказ + " = " + best + " | bestScore=" + bestScore);

return best;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775338901387</Id>
					<Name><![CDATA[определитьТочкиДляЗаказа]]></Name>
					<X>-1100</X><Y>30</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (int k=0; k<количествоМестДляЗаказов; k++) {
	случайнаяТочкаЗаказаВГеоКоорд=nvrn.randomPointInside();
    коллекцияТочекДляЗаказа.add(случайнаяТочкаЗаказаВГеоКоорд);
}
  ]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775338901389</Id>
					<Name><![CDATA[расстояниеКм]]></Name>
					<X>-1100</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[lat1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lon1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lat2]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lon2]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double R = 6371.0;

double dLat = Math.toRadians(lat2 - lat1);
double dLon = Math.toRadians(lon2 - lon1);

double a = Math.sin(dLat / 2) * Math.sin(dLat / 2)
         + Math.cos(Math.toRadians(lat1)) * Math.cos(Math.toRadians(lat2))
         * Math.sin(dLon / 2) * Math.sin(dLon / 2);

double c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

return R * c;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775338901391</Id>
					<Name><![CDATA[расстояниеМ]]></Name>
					<X>-1100</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[lat1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lon1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lat2]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lon2]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[return расстояниеКм(lat1, lon1, lat2, lon2) * 1000.0;]]></Body>
				</Function>
