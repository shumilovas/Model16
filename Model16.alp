							<Value Class="CodeValue">
								<Code><![CDATA[Курьер c = (Курьер) unit;

c.isBusy = false;
c.bannedUntil = time() + tauBan;

agent.последнийОтказавшийсяКурьер = c;
agent.числоОтказов++;

agent.назначенныйКурьер = null;

