					</Parameter>
					<Body><![CDATA[return gisMap.getRouteProvider().getDistance(
    c.getLat(), c.getLon(),
    z.широтаЗабора, z.долготаЗабора
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775318302646</Id>
					<Name><![CDATA[рассчитатьDistanceDropМ]]></Name>
