							<Value Class="CodeValue">
								<Code><![CDATA[Point p = областьДоставки.randomPointInside();

agent.точкаКлиента = p;
agent.широтаКлиента = p.getLatitude();
agent.долготаКлиента = p.getLongitude();

agent.широтаЗабора = широтаДаркстора;
agent.долготаЗабора = долготаДаркстора;

agent.tCreate = time();
agent.prepTime = uniform(5*minute(), 15*minute());
agent.tReady = agent.tCreate + agent.prepTime;
agent.tDeadline = agent.tCreate + 60*minute();

agent.isReady = false;

traceln(
    "SOURCE: pickup lat=" + agent.широтаЗабора +
    ", lon=" + agent.долготаЗабора +
    " | client lat=" + agent.широтаКлиента +
    ", lon=" + agent.долготаКлиента
);]]></Code>
